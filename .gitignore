# Build output. Regenerated by every build, and the same bytes appear twice: the compiler
# writes into obj/ and the last step copies to bin/, so obj/apphost.exe and bin/n52dejavu.exe
# are byte-identical.
bin/
obj/

# The driver catalog is generated by driver/install.ps1 and signed with a certificate that
# script creates on the machine running it. A committed copy would carry one machine's
# signature, mean nothing anywhere else, and be overwritten on the next install anyway.
driver/*.cat

# Probe output. RawInput writes its log beside its own executable, which is inside bin/,
# but keep this in case anyone runs it from elsewhere.
rawprobe-log.txt

# Editors and IDEs
.vs/
.idea/
*.user
*.suo
*.userprefs

# Claude Code keeps machine-specific settings here: absolute paths and a permission
# allowlist that belong to one checkout, not to the project.
.claude/settings.local.json
dist/
