<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DejaVu.App</RootNamespace>

    <!-- No spaces, all lowercase: the file name ends up in scheduled task commands, shortcut
         targets and shell invocations, and a space in any of those needs quoting that is easy
         to get wrong. AssemblyName is also the authority for WPF's pack URIs, so keeping it
         plain keeps those plain. The presentable name is set separately and is what the
         window title and the tray icon show. -->
    <AssemblyName>n52dejavu</AssemblyName>
    <Product>n52 DejaVu</Product>
    <AssemblyTitle>n52 DejaVu</AssemblyTitle>
    <Company>n52 DejaVu</Company>

    <!-- Reaches the file's Details tab in Explorer, which is the only place most people
         would ever look for it. The terms are not MIT: see LICENSE. -->
    <Copyright>Copyright (c) 2026 Shokkstokk. PolyForm Noncommercial 1.0.0 plus a source-availability condition.</Copyright>

    <!-- Shown at the bottom left of the window. One place, read back at runtime. -->
    <Version>1.0.0</Version>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\n52dejavu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DejaVu.Core/DejaVu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user guide travels with the executable, because the Help link at the bottom of
         the window opens it from beside the exe. Copied rather than embedded so it stays a
         file anyone can read without the application running. -->
    <None Include="..\..\docs\help.md" Link="help.md" CopyToOutputDirectory="PreserveNewest" />

    <!-- The guide's images travel with it, into an images\ folder beside help.md - the same
         relative layout as docs\, so its image paths work both on GitHub and when opened from
         the app. Every PNG in the folder ships except app.png, which is the README's full-size
         screenshot and not referenced by the guide. Add a guide image to docs\images and it is
         picked up; add a README-only one and exclude it here. -->
    <None Include="..\..\docs\images\*.png" Exclude="..\..\docs\images\app.png"
          Link="images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly, so the window cannot start without its artwork. -->
    <Resource Include="Assets\device.png" />
    <Resource Include="Assets\tray-plate.png" />
    <Resource Include="Assets\tray-lamp-red.png" />
    <Resource Include="Assets\tray-lamp-green.png" />
    <Resource Include="Assets\tray-lamp-blue.png" />
    <Resource Include="Assets\n52dejavu.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loose XAML that is merged at runtime rather than compiled as a page with a code-behind
         class. Both are ResourceDictionaries the application reaches for by pack URI. -->
    <Page Update="Assets\DeviceGeometry.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Localization\Strings.en.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
