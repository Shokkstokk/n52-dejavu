<!--
  Abyss - deep teal shell, cyan accent. Cool the other way from the default blue

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #162326, Pane #1E2E32, Accent #3CD3E7, Highlight #FFB13B, Live #FFD28D.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#162326" />
  <SolidColorBrush x:Key="Surface" Color="#1E2E32" />
  <SolidColorBrush x:Key="Hover" Color="#283D42" />
  <SolidColorBrush x:Key="Line" Color="#304A50" />

  <SolidColorBrush x:Key="Text" Color="#E5EAEB" />
  <SolidColorBrush x:Key="TextDim" Color="#91A9AF" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#3CD3E7" />
  <SolidColorBrush x:Key="AccentMuted" Color="#245960" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#FFB13B" />
  <SolidColorBrush x:Key="Live" Color="#FFD28D" />

</ResourceDictionary>
