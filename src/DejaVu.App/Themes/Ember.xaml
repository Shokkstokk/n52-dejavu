<!--
  Ember - built on #FF8200. Warm the whole way through - the grays carry the accent's hue, so the shell reads as warm rather than as gray with an orange edge

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #251E17, Pane #31281F, Accent #FF8200, Highlight #4CC9F0, Live #97E0F6.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#251E17" />
  <SolidColorBrush x:Key="Surface" Color="#31281F" />
  <SolidColorBrush x:Key="Hover" Color="#413529" />
  <SolidColorBrush x:Key="Line" Color="#4E4032" />

  <SolidColorBrush x:Key="Text" Color="#EBE8E5" />
  <SolidColorBrush x:Key="TextDim" Color="#AFA091" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#FF8200" />
  <SolidColorBrush x:Key="AccentMuted" Color="#604324" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#4CC9F0" />
  <SolidColorBrush x:Key="Live" Color="#97E0F6" />

</ResourceDictionary>
