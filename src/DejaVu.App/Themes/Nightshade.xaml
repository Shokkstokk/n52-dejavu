<!--
  Nightshade - built on #9000AC. Purple the whole way through, with the orange highlight that started this conversation marking whatever is being edited

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #231726, Pane #2F1E32, Accent #9000AC, Highlight #FF8200, Live #FFB66B.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#231726" />
  <SolidColorBrush x:Key="Surface" Color="#2F1E32" />
  <SolidColorBrush x:Key="Hover" Color="#3E2842" />
  <SolidColorBrush x:Key="Line" Color="#4B3050" />

  <SolidColorBrush x:Key="Text" Color="#EAE5EB" />
  <SolidColorBrush x:Key="TextDim" Color="#A991AF" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#9000AC" />
  <SolidColorBrush x:Key="AccentMuted" Color="#562460" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#FF8200" />
  <SolidColorBrush x:Key="Live" Color="#FFB66B" />

</ResourceDictionary>
