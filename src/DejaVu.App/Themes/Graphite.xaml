<!--
  Graphite - no tint at all - the shell is neutral gray and the violet accent is the only color on the window. The control case for how far tinting is worth taking

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #1E1E1E, Pane #282828, Accent #9E77F8, Highlight #3DD68C, Live #8EE7BC.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Surface" Color="#282828" />
  <SolidColorBrush x:Key="Hover" Color="#353535" />
  <SolidColorBrush x:Key="Line" Color="#404040" />

  <SolidColorBrush x:Key="Text" Color="#E8E8E8" />
  <SolidColorBrush x:Key="TextDim" Color="#A0A0A0" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#9E77F8" />
  <SolidColorBrush x:Key="AccentMuted" Color="#372460" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#3DD68C" />
  <SolidColorBrush x:Key="Live" Color="#8EE7BC" />

</ResourceDictionary>
