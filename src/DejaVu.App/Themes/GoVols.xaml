<!--
  Go Vols - the University of Tennessee's colors. Tennessee orange on smokey gray, with white marking what is being edited and black flashing under a pressed key

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #3A3A3A, Pane #4B4B4B, Accent #FF8200, Highlight #FFFFFF, Live #000000.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Surface" Color="#4B4B4B" />
  <SolidColorBrush x:Key="Hover" Color="#585858" />
  <SolidColorBrush x:Key="Line" Color="#636363" />

  <SolidColorBrush x:Key="Text" Color="#E8E8E8" />
  <SolidColorBrush x:Key="TextDim" Color="#A0A0A0" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#FF8200" />
  <SolidColorBrush x:Key="AccentMuted" Color="#604324" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Live" Color="#000000" />

</ResourceDictionary>
