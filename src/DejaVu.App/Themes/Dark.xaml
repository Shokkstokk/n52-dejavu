<!--
  Dark - the shipped palette. A faintly blue dark rather than a neutral one, and the reference every other theme is measured against

  Generated by scratchpad/makepreset.py from the five colors a theme is made of:
  Shell #1B1D21, Pane #24272C, Accent #4C8DFF, Highlight #3DD68C, Live #8EE7BC.
  Everything else here is derived from those, by the same arithmetic Palette.Build uses -
  so duplicating this preset in the editor reproduces it exactly rather than approximately.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell and panes -->
  <SolidColorBrush x:Key="Background" Color="#1B1D21" />
  <SolidColorBrush x:Key="Surface" Color="#24272C" />
  <SolidColorBrush x:Key="Hover" Color="#30343A" />
  <SolidColorBrush x:Key="Line" Color="#3A3E46" />

  <SolidColorBrush x:Key="Text" Color="#E6E7EA" />
  <SolidColorBrush x:Key="TextDim" Color="#969DA9" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
  <SolidColorBrush x:Key="AccentMuted" Color="#243A60" />

  <!-- Selected, and pressed -->
  <SolidColorBrush x:Key="Highlight" Color="#3DD68C" />
  <SolidColorBrush x:Key="Live" Color="#8EE7BC" />

</ResourceDictionary>
